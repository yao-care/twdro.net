---
import '../styles/tokens.css';
import { url } from '../lib/url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props {
  title: string;
  description?: string;
  lang?: string;
  heroTitle?: string;
  heroDesc?: string;
  bare?: boolean;
}
const {
  title,
  description,
  lang = 'zh-Hant',
  heroTitle,
  heroDesc,
  bare = false,
} = Astro.props;

// meta description 的取用順序：明確傳入 → 該頁的 heroDesc → 全站預設。
// 中間這層 heroDesc fallback 是 2026-07-28 補的：在那之前有 30 個頁面（含首頁、/learn/、
// 全部器材頁與 about 各頁）共用同一句全站預設，等於對搜尋結果放棄了每頁的差異化摘要，
// 而多數頁其實早就寫好 heroDesc、只是沒接到 <meta> 上。這樣接了以後新頁也自動受惠。
const metaDescription =
  description ?? heroDesc ?? '臺灣無人機足球的賽事、規則、隊伍、場地與器材資料，每筆標明來源與查核日期。';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const socialImageUrl = new URL('/og-default.png', Astro.site).toString();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="twdro.net｜臺灣無人機足球" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="twdro.net｜臺灣無人機足球賽事、規則與器材資料" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageUrl} />
    <!-- 訂閱來源全站宣告：閱讀器與聚合器靠這一行自動發現，讀者不必先找到 /events/ 才知道有。 -->
    <link rel="alternate" type="application/rss+xml" title="twdro.net 賽事與公告更新" href={url('/rss.xml')} />
    <!-- Google tag (gtag.js) — GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QGL1VZWJ2Z"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-QGL1VZWJ2Z');

      // 共用的宣告式事件入口：元件只要加 data-ga-event，就會送出一次自訂事件。
      // 參數只讀 data-ga-*，不把整個 href／頁面文字送進 GA，避免把無用內容與個資帶出去。
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('[data-ga-event]');
        if (!(link instanceof HTMLElement)) return;
        const eventName = link.dataset.gaEvent;
        if (!eventName) return;
        const params = {};
        for (const attr of link.attributes) {
          if (!attr.name.startsWith('data-ga-') || attr.name === 'data-ga-event') continue;
          params[attr.name.slice('data-ga-'.length).replace(/-/g, '_')] = attr.value;
        }
        gtag('event', eventName, params);
      }, true);
    </script>
    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    {bare ? (
      <main><slot /></main>
    ) : heroTitle ? (
      <main>
        <section class="page-hero">
          <div class="page-hero__inner">
            <h1>{heroTitle}</h1>
            {heroDesc && <p>{heroDesc}</p>}
          </div>
        </section>
        <div class="page-content"><slot /></div>
      </main>
    ) : (
      <main class="container" style="padding-block: var(--space-7) var(--space-9)"><slot /></main>
    )}
    <SiteFooter />
  </body>
</html>

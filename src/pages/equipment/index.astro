---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EquipmentPriceTable from '../../components/EquipmentPriceTable.astro';
import { url } from '../../lib/url';
import { parsePrice, shortBrand } from '../../lib/price';

// 這頁的定位是「跨品牌比價總覽」——廠商官網只講自家機型，跨品牌比較是本站唯一能提供、
// 而搜尋「無人機飛球／球機」的人真正需要的東西。表格本身抽成共用元件，與教育文同源。
const items = await getCollection('equipment');
const prices = items
  .map((it) => parsePrice(it.data.list_price))
  .filter((p) => !p.soldOut && p.amount != null)
  .map((p) => p.amount!);
const brandCount = new Set(items.map((it) => shortBrand(it.data.brand))).size;
const priceRange = prices.length
  ? `${Math.min(...prices).toLocaleString('en-US')}–${Math.max(...prices).toLocaleString('en-US')}`
  : null;

const metaDescription =
  `臺灣買得到的無人機飛球／無人機足球球機一覽：${brandCount} 個品牌共 ${items.length} 款機型的參考售價與馬達型式` +
  (priceRange ? `，現售價位帶 NT$${priceRange}` : '') +
  '。每筆標明廠商來源與查核日期，並可用合規檢查器比對是否符合賽事分級。';
---
<BaseLayout
  title={`無人機飛球球機比較：${brandCount} 品牌 ${items.length} 款機型的參考售價 | twdro.net`}
  description={metaDescription}
  heroTitle="球機比較與參考售價"
  heroDesc={`臺灣買得到的無人機飛球／無人機足球球機，${brandCount} 個品牌共 ${items.length} 款，價格與規格均標明廠商來源與查核日期。`}
>
  <p style="margin:0 0 24px">
    <a class="btn-action" href={url('/equipment/compliance-check')}>球機合規檢查器 →</a>
  </p>

  <EquipmentPriceTable />

  <p class="text-muted">
    不確定該挑哪一台，先看 <a href={url('/learn/choosing-your-first-drone')}>怎麼挑第一台球機</a>：
    這張表怎麼讀、哪些價差其實是配件差、哪些機型只賣給教育單位。
  </p>
</BaseLayout>

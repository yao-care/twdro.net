---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceBlock from '../../components/SourceBlock.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { parsePrice, motorLabel as toMotorLabel, shortBrand } from '../../lib/price';
import { url } from '../../lib/url';
export async function getStaticPaths() {
  const items = await getCollection('equipment');
  const orgs = await getCollection('organizations');
  return items.map((it) => ({
    params: { slug: it.id },
    // 廠商條目在建置期解析：slug 打錯或條目被刪，這裡就是 undefined、畫面安靜少一行。
    // 那種靜默壞法由 tests/organization-links.test.ts 擋下（打錯字要 build 失敗，不是少一個連結）。
    props: { item: it, org: orgs.find((o) => o.id === it.data.brand_slug) ?? null },
  }));
}
const { item, org } = Astro.props;
const d = item.data;

const motorLabel = toMotorLabel(d.motor_type);

// 只列有值的規格，缺的安靜省略（不顯示佔位）
const rows: [string, string][] = [
  d.diameter_mm != null ? ['直徑', `${d.diameter_mm} mm`] : null,
  d.weight_g != null ? ['重量', `${d.weight_g} g`] : null,
  motorLabel ? ['馬達', motorLabel] : null,
  d.battery_voltage ? ['電池', d.battery_voltage] : null,
  d.list_price ? ['參考售價', d.list_price] : null,
].filter((r): r is [string, string] => r !== null);

// 短版價格與品牌的規則集中在 lib/price（比較表、明細頁摘要、標題共用一套）。
const { text: priceText } = parsePrice(d.list_price);
const brandShort = shortBrand(d.brand);

// meta description 逐機生成：heroDesc 原本是固定的「球機規格」四個字，12 個器材頁共用它
// 等於在搜尋結果上完全無法區分。查機型的人多半在比價，把價格帶進摘要而不是只承諾「有標售價」。
const specSummary = rows
  .filter(([k]) => k !== '參考售價')
  .map(([k, v]) => `${k} ${v}`)
  .join('、');
const metaDescription =
  // 型號本身常以「（…）」結尾，再括一次品牌會變成連續兩組括號；改用破折號分隔。
  `${d.model}－${brandShort}的球機規格${specSummary ? `：${specSummary}` : ''}。` +
  (priceText ? `參考售價 ${priceText}。` : '') +
  '規格與售價標明廠商來源與查核日期。';
// 標題只在頁面真的列了售價時才寫「與參考售價」，不做內容沒有的承諾。
const pageTitle = `${d.model}${priceText ? ' 規格與參考售價' : ' 規格'}｜${brandShort} | twdro.net`;
const heroDesc = [brandShort, specSummary, priceText ? `參考售價 ${priceText}` : null]
  .filter(Boolean)
  .join('・');
---
<BaseLayout title={pageTitle} description={metaDescription} heroTitle={`${d.brand} ${d.model}`} heroDesc={heroDesc}>
  <Breadcrumb items={[{ name: '首頁', href: '/' }, { name: '器材', href: '/equipment/' }, { name: `${d.brand} ${d.model}`, href: `/equipment/${item.id}/` }]} />
  {rows.length > 0 && (
    <section class="panel">
      <ul class="data-list">
        {rows.map(([k, v]) => <li><span class="k">{k}</span><span class="v">{v}</span></li>)}
      </ul>
    </section>
  )}
  {org && (
    <section class="panel">
      <h2 style="margin-top:0">這台是誰做的</h2>
      <p style="margin:0">
        {d.model} 由 <a href={url(`/organizations/${org.id}/`)} style="font-weight:650">{org.data.name} →</a> 生產或代理。
        該單位在臺灣無人機足球裡做了什麼、有沒有開課或營隊，都在單位頁上，並標明來源。
      </p>
    </section>
  )}
  {d.sources && d.sources.length > 0 && (
    <section class="panel"><SourceBlock sources={d.sources} title={`${d.brand} ${d.model}`} /></section>
  )}
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import EquipmentPriceTable from '../../components/EquipmentPriceTable.astro';
import EventSeriesTable from '../../components/EventSeriesTable.astro';
import OrganizationsTable from '../../components/OrganizationsTable.astro';
import { articleJsonLd } from '../../lib/jsonld';
export async function getStaticPaths() {
  const articles = await getCollection('learn');
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const pageUrl = new URL(`/learn/${article.id}/`, Astro.site).toString();
// 教育文只有 updated_at；作為 dateModified，並在無更早發布日時同時作為 datePublished。
const articleJson = articleJsonLd({
  headline: article.data.title,
  description: article.data.description,
  url: pageUrl,
  datePublished: article.data.updated_at,
  dateModified: article.data.updated_at,
});
---
<BaseLayout title={`${article.data.title} | twdro.net`} description={article.data.description} heroTitle={article.data.title} heroDesc={article.data.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleJson)} />
  <Breadcrumb items={[{ name: '首頁', href: '/' }, { name: '認識無人機足球', href: '/learn/' }, { name: article.data.title, href: `/learn/${article.id}/` }]} />
  <article class="panel prose">
    <Content />
    {article.data.embed === 'equipment-price-table' && <EquipmentPriceTable />}
    {article.data.embed === 'event-series' && article.data.embed_series && (
      <EventSeriesTable series={article.data.embed_series} itemLabel={article.data.embed_item_label} />
    )}
    {article.data.embed === 'organizations' && <OrganizationsTable />}
  </article>
</BaseLayout>

<script>
  // 各篇教育文的 d3 示意圖：以 <div class="d3-figure" data-figure="<id>"> 掛載，
  // 依 data-figure 只 lazy-load 該篇對應的圖模組（Vite 會 code-split，不會整包載入）。
  const figures = import.meta.glob('../../figures/*.ts');
  const mount = document.querySelector<HTMLElement>('[data-figure]');
  if (mount) {
    const id = mount.dataset.figure;
    const loader = figures[`../../figures/${id}.ts`];
    if (loader) {
      const mod = (await loader()) as { default: (el: HTMLElement) => void };
      mod.default(mount);
    }
  }
</script>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { url } from '../../lib/url';
import { orgTypeLabel } from '../../lib/enums';
import { organizationJsonLd } from '../../lib/jsonld';
import SourceBlock from '../../components/SourceBlock.astro';
export async function getStaticPaths() {
  const orgs = await getCollection('organizations');
  const teams = await getCollection('teams');
  return orgs.map((o) => ({
    params: { slug: o.id },
    props: { org: o, teams: teams.filter((t) => t.data.organization === o.id) },
  }));
}
const { org, teams } = Astro.props;
const d = org.data;
// 實體明細頁原本只有 BreadcrumbList——頁面在描述一個單位，卻沒有任何 Organization 節點。
const jsonld = organizationJsonLd({
  name: d.name, url: `https://twdro.net/organizations/${org.id}/`,
  website: d.website, city: d.city, country: d.country,
});
---
<BaseLayout title={`${d.name} | twdro.net`} description={`${d.name}——${orgTypeLabel(d.org_type)}${d.country ? `，${d.country}` : '，臺灣'}推動無人機足球的單位。`} heroTitle={d.name} heroDesc={orgTypeLabel(d.org_type)}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <Breadcrumb items={[{ name: '首頁', href: '/' }, { name: '參與單位', href: '/organizations/' }, { name: d.name, href: `/organizations/${org.id}/` }]} />
  <section class="panel">
    <ul class="data-list">
      <li><span class="k">類型</span><span class="v">{orgTypeLabel(d.org_type)}</span></li>
      {d.country && <li><span class="k">國家／地區</span><span class="v">{d.country}</span></li>}
      {d.city && <li><span class="k">所在地</span><span class="v">{d.city}</span></li>}
      {d.website && <li><span class="k">官方網站</span><span class="v"><a href={d.website} rel="nofollow noopener" target="_blank" style="font-weight:650">前往官網 ↗</a></span></li>}
    </ul>
  </section>

  {d.programs && d.programs.length > 0 && (
    <section class="panel">
      <h2>開設的課程／營隊</h2>
      <ul class="data-list">
        {d.programs.map((p) => <li><span class="v">{p}</span></li>)}
      </ul>
      {/* 本站不經手報名也不收費，寫明白比讓讀者猜好；價格一律不寫（鐵則 5）。 */}
      <p class="text-muted" style="font-size:1rem;margin:12px 0 0">
        開課時間、對象與費用以該單位公告為準，本站不代收報名、不排名亦不推薦。
      </p>
    </section>
  )}

  {teams.length > 0 && (
    <section class="panel">
      <h2>相關隊伍</h2>
      <ul class="card-grid">
        {teams.map((t) => (
          <li>
            <a class="card-link" href={url(`/teams/${t.id}`)}>
              <span class="name">{t.data.name}</span>
              {t.data.city && <span class="meta">{[t.data.city, t.data.district].filter(Boolean).join(' ')}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {d.sources && d.sources.length > 0 && (
    <section class="panel"><SourceBlock sources={d.sources} title={d.name} /></section>
  )}

  <p class="text-muted" style="font-size:1rem;margin-top:16px">收錄以公開資料佐證有推動無人機足球之單位；不含個別選手資訊。<a href={url('/organizations/')}>← 回參與單位列表</a></p>
</BaseLayout>

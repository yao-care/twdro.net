---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
import { ORG_TYPE_ORDER, orgTypeLabel } from '../../lib/enums';
import { collectionPageJsonLd } from '../../lib/jsonld';
const orgs = await getCollection('organizations');
// 標籤與順序的單一來源在 lib/enums.ts（先前這裡、明細頁、OrganizationsTable 各抄一份）。
// 收錄了但不在 ORG_TYPE_ORDER 裡的型態排到最後，才不會有單位建了檔卻整組不顯示。
const known = ORG_TYPE_ORDER.filter((k) => orgs.some((o) => o.data.org_type === k));
const extra = [...new Set(orgs.map((o) => o.data.org_type))].filter(
  (k) => !(ORG_TYPE_ORDER as readonly string[]).includes(k),
);
const GROUPS: [string, string][] = [...known, ...extra].map((k) => [k, orgTypeLabel(k)]);

const jsonld = collectionPageJsonLd({
  name: '無人機足球推廣單位',
  url: 'https://twdro.net/organizations/',
  description: '臺灣推動無人機足球的協會、學校、大學、開課單位、廠商與政府單位，以及訂定規則的國際組織。',
  items: orgs.map((o) => ({ name: o.data.name, url: `https://twdro.net/organizations/${o.id}/` })),
});

---
<BaseLayout
  title="台灣無人機足球協會、學校與推廣單位 | twdro.net"
  description="台灣（臺灣）無人機足球協會、學校、政府、廠商與開課單位名錄，也整理 FAI／FIDA 等國際規則組織。"
  heroTitle="台灣無人機足球推廣單位"
  heroDesc="查台灣（臺灣）推動無人機足球的協會、學校、政府、廠商與課程單位。"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <section class="panel" style="margin-bottom:20px">
    <h2>台灣無人機足球要找誰</h2>
    <p style="margin:0 0 16px">
      這份名錄整理台灣推動無人機足球的協會、學校、政府、廠商與開課單位，也收錄制定國際規則的組織。
      如果你的目的是找比賽，先看<a href={url('/events')}>台灣無人機足球賽事</a>；想了解各類單位負責什麼，再讀
      <a href={url('/learn/who-promotes-drone-soccer-taiwan')} style="font-weight:650">臺灣有哪些單位在推無人機足球</a>。
    </p>
    <ul class="card-grid" style="margin:0">
      <li><a class="card-link" href={url('/events')}><span class="name">找比賽與報名</span><span class="meta">看賽程、地點、報名狀態與成績</span></a></li>
      <li><a class="card-link" href={url('/equipment')}><span class="name">找器材與課程方案</span><span class="meta">比較球機價格，先對準目標賽事規格</span></a></li>
      <li><a class="card-link" href={url('/teams')}><span class="name">找隊伍與學校</span><span class="meta">從現有隊伍與所屬單位開始接觸</span></a></li>
    </ul>
  </section>
  {GROUPS.map(([key, label]) => {
    const list = orgs.filter((o) => o.data.org_type === key);
    return list.length ? (
      <section id={key}>
        <h2 class="group-title">{label}</h2>
        <ul class="card-grid">
          {list.map((o) => (
            <li>
              <a class="card-link" href={url(`/organizations/${o.id}`)}>
                <span class="name">{o.data.name}</span>
                {(o.data.country || o.data.city) && <span class="meta">{[o.data.country, o.data.city].filter(Boolean).join(' ')}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null;
  })}
  <p class="text-muted" style="font-size:1rem;margin-top:24px">收錄以公開資料佐證有推動無人機足球之單位；不含個別選手資訊。</p>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
const orgs = await getCollection('organizations');
const GROUPS: [string, string][] = [
  ['association', '協會'], ['university', '大學'], ['school', '學校'],
  ['vendor', '器材／課程廠商'], ['government', '政府單位'],
  // 2026-08-03 加：站上到處引用 FIDA／FAI 的規則書，讀者卻查不到規則是誰訂的。
  ['international_body', '國際組織'],
];
---
<BaseLayout
  title="無人機足球推廣單位：臺灣協會學校廠商與國際組織 | twdro.net"
  description="臺灣公開推動無人機足球的協會、學校、大學、廠商與政府單位，以及訂定規則的國際組織。"
  heroTitle="推廣單位"
  heroDesc="臺灣公開推動無人機足球的單位，以及訂定規則的國際組織。"
>
  {GROUPS.map(([key, label]) => {
    const list = orgs.filter((o) => o.data.org_type === key);
    return list.length ? (
      <section>
        <h2 class="group-title">{label}</h2>
        <ul class="card-grid">
          {list.map((o) => (
            <li>
              <a class="card-link" href={url(`/organizations/${o.id}`)}>
                <span class="name">{o.data.name}</span>
                {(o.data.country || o.data.city) && <span class="meta">{[o.data.country, o.data.city].filter(Boolean).join(' ')}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null;
  })}
  <p class="text-muted" style="font-size:1rem;margin-top:24px">收錄以公開資料佐證有推動無人機足球之單位；不含個別選手資訊。</p>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { url } from '../../../lib/url';
import { isPublicEvent } from '../../../lib/enums';
import { yearOf, aggHref } from '../../../lib/aggregate.mjs';
import { hasPublishedResults, awaitsResults, publishedDivisions, teamText, hasTeam, FINISHED_STATUSES, type ResultBlock } from '../../../lib/results';
import { dateRangeText } from '../../../lib/schedule';
import { citySlug } from '../../../lib/geo.mjs';
import { collectionPageJsonLd, breadcrumbJsonLd } from '../../../lib/jsonld';

// 年度頁承接的是「今年有哪些比賽」這種時間軸查詢。它是四個彙整維度裡最弱的一個，
// 但成本近乎零（同一份資料再切一刀），而且它是唯一能一眼看出「這項運動在臺灣長多快」的頁：
// 2025 年 4 場、2026 年 15 場。
//
// 2026-11-15 用戶拍板：**單場賽事頁不收錄，搜尋集中到這張年度總表**（規則與理由見
// src/lib/noindex.mjs 的 eventDetailPaths）。所以這一頁不能只是一疊賽事卡——單場頁被
// noindex 之後，搜尋者落地看到的就是這裡，每一場的日期、地點、主辦、組別、成績或報名連結
// 都要直接攤在這頁上。全部只取自 src/content/events 既有欄位，沒有的欄位印「—」，不補推測值。
export async function getStaticPaths() {
  const events = (await getCollection('events')).filter((e) => isPublicEvent(e.data.status));
  const years = [...new Set(events.map((e) => yearOf(e.data.schedule.event_start)).filter((y): y is string => !!y))];
  return years.map((year) => ({
    params: { year },
    props: {
      year,
      events: events
        .filter((e) => yearOf(e.data.schedule.event_start) === year)
        .sort((a, b) => (b.data.schedule.event_start ?? '').localeCompare(a.data.schedule.event_start ?? '')),
      allYears: years.slice().sort(),
    },
  }));
}

const { year, events, allYears } = Astro.props;
const seriesNames = [...new Set(events.map((e) => e.data.event_series).filter(Boolean))] as string[];
const cities = [...new Set(events.map((e) => e.data.schedule.city).filter(Boolean))] as string[];
const withResults = events.filter((e) => hasPublishedResults(e.data.results));

const metaDescription =
  `${year} 年無人機足球比賽總表：本站收錄 ${events.length} 場賽事，涵蓋 ${seriesNames.length} 個系列、`
  + `${cities.length} 個縣市，逐場列出日期、地點、主辦、組別與成績或報名連結，其中 ${withResults.length} 場已公布成績。`;

/** 組別：教育階段＋成績分組名稱，都是資料裡的原文。 */
function divisionText(d: (typeof events)[number]['data']): string {
  const parts = [...(d.eligibility.education_levels ?? [])];
  for (const g of d.results?.divisions ?? []) if (g.name && !parts.includes(g.name)) parts.push(g.name);
  return parts.join('、');
}
/** 成績摘要：每組冠軍（沒有冠軍就取第一個有資料的名次）。 */
function resultLines(r?: ResultBlock): string[] {
  const first = (b: ResultBlock): string => {
    if (hasTeam(b.champion_team)) return `冠軍 ${teamText(b.champion_team)}`;
    if (hasTeam(b.runner_up_team)) return `亞軍 ${teamText(b.runner_up_team)}`;
    if (hasTeam(b.third_place_team)) return `季軍 ${teamText(b.third_place_team)}`;
    if (hasTeam(b.fourth_place_team)) return `殿軍 ${teamText(b.fourth_place_team)}`;
    const o = b.other_places?.[0];
    if (o) return `${o.place} ${teamText(o.team)}`;
    if (b.merit_teams?.length) return `優勝 ${b.merit_teams.join('、')}`;
    return '';
  };
  const lines: string[] = [];
  const top = first(r ?? {});
  if (top) lines.push(top);
  for (const g of publishedDivisions(r)) {
    const t = first(g);
    if (t) lines.push(g.name ? `${g.name}：${t}` : t);
  }
  return lines;
}
const rows = events.map((e) => {
  const d = e.data;
  const finished = (FINISHED_STATUSES as readonly string[]).includes(d.status);
  return {
    id: e.id,
    title: d.title,
    status: d.status,
    date: dateRangeText(d.schedule.event_start, d.schedule.event_end, { fallback: '未定' }),
    place: [d.country, d.schedule.city, d.schedule.venue_name].filter(Boolean).join(' · '),
    organizer: d.organizer ?? '',
    division: divisionText(d),
    results: resultLines(d.results),
    awaiting: awaitsResults(d.status, d.results),
    registrationUrl: !finished && d.status !== 'cancelled' ? d.registration_url : undefined,
    registrationEnd: d.schedule.registration_end,
  };
});

const jsonld = collectionPageJsonLd({
  name: `${year} 年無人機足球比賽總表`,
  url: `https://twdro.net${aggHref('/events/year/', year)}`,
  description: metaDescription,
  items: events.map((e) => ({ name: e.data.title, url: `https://twdro.net/events/${e.id}/` })),
});
const crumbs = breadcrumbJsonLd([
  { name: '首頁', url: 'https://twdro.net/' },
  { name: '賽事', url: 'https://twdro.net/events/' },
  { name: `${year} 年`, url: `https://twdro.net${aggHref('/events/year/', year)}` },
]);
---
<BaseLayout
  title={`${year} 無人機足球比賽總表：臺灣賽事日期、地點、主辦與成績 | twdro.net`}
  description={metaDescription}
  heroTitle={`${year} 年無人機足球比賽與賽事總表`}
  heroDesc={`${year} 年臺灣無人機足球（無人機飛球）比賽 ${events.length} 場、${seriesNames.length} 個系列、${cities.length} 個縣市，逐場列出日期、地點、主辦、組別與成績。`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbs)} />
  <Breadcrumb items={[{ name: '首頁', href: '/' }, { name: '賽事', href: '/events/' }, { name: `${year} 年`, href: aggHref('/events/year/', year) }]} />

  {allYears.length > 1 && (
    <p style="margin:0 0 20px;line-height:2">
      {allYears.map((y) => (
        <><a href={url(aggHref('/events/year/', y))} style={`display:inline-block;padding:.25rem .8rem;margin-right:.5rem;border-radius:999px;border:1px solid var(--color-border)${y === year ? ';background:var(--color-surface-muted);font-weight:700' : ''}`}>{y}</a></>
      ))}
    </p>
  )}

  <section style="margin-bottom:32px">
    <h2 style="margin:0 0 6px">{year} 年無人機足球賽事一覽</h2>
    <p style="margin:0 0 16px;color:var(--color-text-muted)">
      依比賽日期由近到遠排列。資料取自主辦單位公告與新聞，每一場的來源與查核日期在該場的賽事頁；
      查不到的欄位留「—」，不以推測填補。報名與賽程以主辦單位公告為準。
    </p>
    <div style="display:grid;gap:16px">
      {rows.map((row) => (
        <article class="panel year-event" id={row.id} style="margin:0">
          <h3 style="margin:0 0 8px;font-size:1.08rem"><a href={url(`/events/${row.id}/`)}>{row.title}</a></h3>
          <StatusBadge status={row.status} />
          <ul class="data-list" style="margin-top:10px">
            <li><span class="k">日期</span><span class="v">{row.date}</span></li>
            <li><span class="k">地點</span><span class="v">{row.place || '—'}</span></li>
            <li><span class="k">主辦</span><span class="v">{row.organizer || '—'}</span></li>
            <li><span class="k">組別</span><span class="v">{row.division || '—'}</span></li>
            {row.results.length > 0 ? (
              <li><span class="k">成績</span><span class="v">
                {row.results.map((t) => <span style="display:block">{t}</span>)}
                <a href={url(`/events/${row.id}/`)} style="font-size:.95rem">完整名次與來源 →</a>
              </span></li>
            ) : row.registrationUrl ? (
              <li><span class="k">報名</span><span class="v">
                <a href={row.registrationUrl} rel="nofollow noopener" target="_blank"
                  data-ga-event="registration_click" data-ga-event-id={row.id} data-ga-event-title={row.title} data-ga-event-status={row.status}>報名連結 ↗</a>
                {row.registrationEnd && <span style="display:block;color:var(--color-text-muted)">報名截止 {row.registrationEnd}</span>}
              </span></li>
            ) : row.awaiting ? (
              <li><span class="k">成績</span><span class="v">已結束，主辦尚未公開成績（<a href={url(`/events/${row.id}/`)}>提供成績</a>）</span></li>
            ) : (
              <li><span class="k">報名／成績</span><span class="v">尚無公開報名連結，<a href={url(`/events/${row.id}/`)}>看賽事頁 →</a></span></li>
            )}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="panel" style="margin-bottom:20px">
    <h2 style="margin-top:0">{year} 年的系列與縣市</h2>
    <p style="margin:0 0 10px;line-height:2">
      {seriesNames.map((s) => (
        <><a href={url(aggHref('/events/series/', s))} style="display:inline-block;padding:.2rem .7rem;margin:0 .4rem .2rem 0;border:1px solid var(--color-border);border-radius:999px">{s}</a></>
      ))}
    </p>
    <p style="margin:0;line-height:2">
      {cities.map((c) => citySlug(c) && (
        <><a href={url(`/events/city/${citySlug(c)}/`)} style="display:inline-block;padding:.2rem .7rem;margin:0 .4rem .2rem 0;border:1px solid var(--color-border);border-radius:999px">{c}</a></>
      ))}
    </p>
  </section>

  <section class="panel">
    <h2 style="margin-top:0">漏了 {year} 年的場次？</h2>
    <p style="margin:0 0 14px">本站只收錄查得到公開資料的場次。知道我們沒有的，直接告訴我們，會標明來源與查核日期後補上。</p>
    <p style="margin:0"><a class="btn-action" href={url('/about/correction/')}>提供賽事或成績 →</a></p>
  </section>
</BaseLayout>

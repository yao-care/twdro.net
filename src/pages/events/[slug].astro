---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import SourceBlock from '../../components/SourceBlock.astro';
import { eventJsonLd } from '../../lib/jsonld';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { url } from '../../lib/url';
import { hasTeam, teamText, hasAnyPlace, publishedDivisions, hasPublishedResults, awaitsResults, FINISHED_STATUSES } from '../../lib/results';
import { isPublicEvent, verificationLabel } from '../../lib/enums';
import { citySlug } from '../../lib/geo.mjs';
import { aggHref } from '../../lib/aggregate.mjs';
import { eventPageTitle, eventPageDescription } from '../../lib/eventSeo';
import { dateRangeText } from '../../lib/schedule';
import { resultsMailto, resultsUrl, correctionMailto } from '../../lib/correction';
export async function getStaticPaths() {
  const events = await getCollection('events');
  // 草稿賽事不產生公開頁（無公開 URL）；人工把 status 升級後才會有頁面。
  return events.filter((e) => isPublicEvent(e.data.status))
    .map((e) => ({ params: { slug: e.id }, props: { event: e } }));
}
const RULE_LABEL: Record<string, string> = { FAI: 'FAI', FIDA: 'FIDA', MOE: '教育部', OTHER: '民間賽事' };
const { event } = Astro.props;
const d = event.data;

// 主辦單位／場地是事實型自由文字欄位，不是關聯 slug；只在完全同名時才連結到明細頁，
// 不做模糊比對——寧可漏連，不可連錯（鐵則 5：不杜撰）。
const [orgs, venuesList, learnArticles] = await Promise.all([
  getCollection('organizations'),
  getCollection('venues'),
  getCollection('learn'),
]);
const orgIdByName = new Map(orgs.map((o) => [o.data.name, o.id]));
const venueIdByName = new Map(venuesList.map((v) => [v.data.name, v.id]));
// 主辦單位的站內頁：優先用 organizer_slugs（陣列，因為這裡的賽事幾乎都多方合辦），
// 沒填的賽事才退回舊的「organizer 字串完全等於 organizations.name」比對。
// 舊做法是全有全無的：「新北市教育局／台北市電腦商業同業公會／奧斯丁國際」比不到任何一家，
// 於是三個合辦單位一個都連不到——而其中奧斯丁在站上是有頁的（2026-08-27）。
const organizerOrgs = (d.organizer_slugs ?? []).length
  ? (d.organizer_slugs ?? []).map((slug) => orgs.find((o) => o.id === slug)).filter((o) => o != null)
  : (d.organizer && orgIdByName.has(d.organizer)
      ? [orgs.find((o) => o.id === orgIdByName.get(d.organizer!))!]
      : []);
// 我方最後確認日：取各來源 retrieved_at 的最大值，與 sitemap lastmod 同一套語意。
// 尚未舉行的賽事把它明講出來——這一場已經因颱風延期過一次，而讀者是要決定要不要出門的人。
// 地點連到該縣市的彙整頁：看完這一場的人，下一個問題通常是「這附近還有嗎」。
const cityHref = citySlug(d.schedule.city) ? url(`/events/city/${citySlug(d.schedule.city)}/`) : null;
const lastChecked = (d.sources ?? [])
  .map((x) => x.retrieved_at)
  .filter((x): x is string => !!x)
  .sort()
  .at(-1);
const venueId = d.schedule.venue_name ? venueIdByName.get(d.schedule.venue_name) : undefined;
// 趨勢文章以 trend-<event id> 命名 trend_id（見 scripts/trend-radar.mjs），配對後在賽事頁反向連回，
// 否則這類文章只掛在 learn 分類索引，沒有其他頁面連進去。
const relatedArticles = learnArticles.filter((a) => a.data.trend_id === `trend-${event.id}`);
const hasLocation = !!(d.schedule.city || d.schedule.venue_name);
const isOpen = d.status === 'registration_open';
const jsonld = eventJsonLd({
  name: d.title,
  startDate: d.schedule.event_start,
  endDate: d.schedule.event_end,
  url: new URL(url(`/events/${event.id}`), Astro.site).toString(),
  locationName: d.schedule.venue_name,
});

const levels = d.eligibility.education_levels ?? [];
const hasTeamSize = d.eligibility.team_size_min != null || d.eligibility.team_size_max != null;
const teamSizeText = [d.eligibility.team_size_min, d.eligibility.team_size_max].every((n) => n != null)
  ? `${d.eligibility.team_size_min}–${d.eligibility.team_size_max} 人`
  : `${d.eligibility.team_size_min ?? d.eligibility.team_size_max} 人`;
const showEligibility = levels.length > 0 || hasTeamSize;
const showCompetition = d.competition.drone_class != null
  || d.competition.drone_diameter != null
  || d.competition.active_drones_per_team != null;
// 「有沒有成績」「算不算在等成績」的判斷集中在 lib/results（與 /events/results/ 共用一套）。
const r = d.results;
const divisionResults = publishedDivisions(r);
const showResults = hasPublishedResults(r);
// 已結束但查不到成績 → 開徵稿入口。這是站上最大的資料缺口（2026-07-30 實查：全臺沒有
// 任何可爬取的網頁在公布無人機足球成績，連主辦單位官網都沒有），而看得到成績的是到過
// 現場的隊伍、指導老師與承辦學校。取消／延期的賽事沒有成績可談，不出這一段。
const wantsResults = awaitsResults(d.status, r);
// title/description 交給 lib/eventSeo 依生命週期組（意圖詞＋年份、事實句），理由見該檔開頭。
// 畫面上的 hero 仍用正式全名與 subtitle，不受搜尋用的字串影響。
const seoTitle = eventPageTitle(d);
const seoDesc = eventPageDescription(d);
---
<BaseLayout title={`${seoTitle} | twdro.net`} description={seoDesc || undefined} heroTitle={d.title} heroDesc={d.subtitle}>
  {jsonld && <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />}
  <Breadcrumb items={[{ name: '首頁', href: '/' }, { name: '賽事', href: '/events/' }, { name: d.title, href: `/events/${event.id}/` }]} />

  <section class="panel" style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;justify-content:space-between;margin-bottom:20px">
    <StatusBadge status={d.status} />
    {d.registration_url && (
      <a
        class="btn-action"
        href={d.registration_url}
        rel="nofollow noopener"
        target="_blank"
        style={isOpen ? '' : 'background:var(--color-brand);color:#fff'}
        data-ga-event="registration_click"
        data-ga-event-id={event.id}
        data-ga-event-title={d.title}
        data-ga-event-status={d.status}
      >
        {isOpen ? '立即報名 →' : '前往報名 ↗'}
      </a>
    )}
  </section>

  {(!d.sources || d.sources.length === 0 || d.verification === 'outdated') && (
    <p style="margin:0 0 20px;padding:12px 14px;border-radius:10px;border:1px solid var(--color-warning);background:color-mix(in oklab, var(--color-warning) 14%, var(--color-surface));font-size:1rem">
      <strong>這一頁的資料狀態是「{verificationLabel(d.verification)}」</strong>
      {(!d.sources || d.sources.length === 0) && '，而且本站尚未附上可追溯的來源連結'}。
      內容僅供參考，請以主辦單位公告為準。
      知道正確資訊或找得到原始公告的話，
      <a href={correctionMailto({ path: `/events/${event.id}/`, title: d.title })} style="font-weight:650">來信告訴我們</a>，
      我們會補上來源與查核日期。
      {/* 2026-08-27 加。原本 verification 只在 SourceBlock 裡顯示，而 SourceBlock 只在「有來源」時才渲染
          ——於是**最沒有依據的頁面反而完全不出現任何警示**。第三屆教育科技盃新北場就是實例：
          verification: outdated、零來源，卻是站上曝光第二高的頁（GSC 近 90 天 18 次、pos 6.9）。 */}
    </p>
  )}

  {lastChecked && !FINISHED_STATUSES.includes(d.status as any) && (
    <p
      class="event-freshness"
      data-last-checked={lastChecked}
      style="margin:0 0 20px;padding:12px 14px;border-radius:10px;background:var(--color-surface-muted);font-size:1rem"
    >
      本頁資料由本站最後確認於 <strong>{lastChecked}</strong><span class="event-freshness__age"></span>。
      賽事的時間、地點與報名方式都可能變動——<strong>出發或報名前請向主辦單位再確認一次</strong>。
      本站不代收報名，來源連結在頁面最下方。
    </p>
  )}

  <section class="panel">
    <h2>基本資訊</h2>
    <ul class="data-list">
      {d.event_series && <li><span class="k">賽事系列</span><span class="v">
        <a href={url(aggHref('/events/series/', d.event_series))}>{d.event_series}</a>
      </span></li>}
      {d.event_type && <li><span class="k">賽事類型</span><span class="v">{d.event_type}</span></li>}
      {d.level && <li><span class="k">層級</span><span class="v">{d.level}</span></li>}
      <li><span class="k">主辦</span><span class="v">
        {d.organizer ?? '—'}
        {organizerOrgs.length > 0 && (
          <span style="display:block;margin-top:4px;font-size:.95rem;color:var(--color-text-muted)">
            站內單位頁：{organizerOrgs.map((o, i) => (
              <>{i > 0 && '、'}<a href={url(`/organizations/${o!.id}/`)}>{o!.data.name}</a></>
            ))}
          </span>
        )}
      </span></li>
      <li><span class="k">規則體系</span><span class="v">{RULE_LABEL[d.rule_system] ?? d.rule_system}</span></li>
      {d.rulebook && <li><span class="k">規則書</span><span class="v"><a href={url(`/rules/${d.rulebook}`)} style="font-weight:650">查看規則書 →</a></span></li>}
      <li><span class="k">日期</span><span class="v">{dateRangeText(d.schedule.event_start, d.schedule.event_end, { fallback: '未定' })}</span></li>
      <li><span class="k">地點</span><span class="v">
        {hasLocation
          ? <>
              {d.schedule.city && (cityHref
                ? <a href={cityHref}>{d.schedule.city}</a>
                : d.schedule.city)}
              {d.schedule.city && d.schedule.venue_name && ' · '}
              {d.schedule.venue_name && (venueId
                ? <a href={url(`/venues/${venueId}`)}>{d.schedule.venue_name}</a>
                : d.schedule.venue_name)}
            </>
          : '—'}
      </span></li>
      {d.schedule.registration_end && <li><span class="k">報名截止</span><span class="v">{d.schedule.registration_end}</span></li>}
    </ul>
  </section>

  {showEligibility && (
    <section class="panel">
      <h2>參賽資格</h2>
      <ul class="data-list">
        {levels.length > 0 && <li><span class="k">組別</span><span class="v">{levels.join('、')}</span></li>}
        {hasTeamSize && <li><span class="k">隊伍人數</span><span class="v">{teamSizeText}</span></li>}
      </ul>
    </section>
  )}

  {showCompetition && (
    <section class="panel">
      <h2>球機規格</h2>
      <ul class="data-list">
        {d.competition.drone_class != null && <li><span class="k">級別</span><span class="v">{d.competition.drone_class}</span></li>}
        {d.competition.drone_diameter != null && <li><span class="k">直徑</span><span class="v">{d.competition.drone_diameter}</span></li>}
        {d.competition.active_drones_per_team != null && <li><span class="k">場上球機</span><span class="v">{d.competition.active_drones_per_team}</span></li>}
      </ul>
    </section>
  )}

  {showResults && (
    <section class="panel">
      <h2>成績</h2>
      {hasAnyPlace(r) && (
        <ul class="data-list">
          {hasTeam(r?.champion_team) && <li><span class="k">冠軍</span><span class="v">{teamText(r?.champion_team)}</span></li>}
          {hasTeam(r?.runner_up_team) && <li><span class="k">亞軍</span><span class="v">{teamText(r?.runner_up_team)}</span></li>}
          {hasTeam(r?.third_place_team) && <li><span class="k">季軍</span><span class="v">{teamText(r?.third_place_team)}</span></li>}
          {hasTeam(r?.fourth_place_team) && <li><span class="k">殿軍</span><span class="v">{teamText(r?.fourth_place_team)}</span></li>}
            {(r?.merit_teams?.length ?? 0) > 0 && <li><span class="k">優勝</span><span class="v">{r!.merit_teams!.join("、")}</span></li>}
          {(r?.other_places ?? []).map((o) => (
            <li><span class="k">{o.place}</span><span class="v">{teamText(o.team)}</span></li>
          ))}
        </ul>
      )}
      {divisionResults.map((g) => (
        <div style="margin-top:12px">
          <h3 style="margin:0 0 6px;font-size:1rem">{g.name}</h3>
          <ul class="data-list">
            {hasTeam(g.champion_team) && <li><span class="k">冠軍</span><span class="v">{teamText(g.champion_team)}</span></li>}
            {hasTeam(g.runner_up_team) && <li><span class="k">亞軍</span><span class="v">{teamText(g.runner_up_team)}</span></li>}
            {hasTeam(g.third_place_team) && <li><span class="k">季軍</span><span class="v">{teamText(g.third_place_team)}</span></li>}
            {hasTeam(g.fourth_place_team) && <li><span class="k">殿軍</span><span class="v">{teamText(g.fourth_place_team)}</span></li>}
            {(g.merit_teams?.length ?? 0) > 0 && <li><span class="k">優勝</span><span class="v">{g.merit_teams!.join("、")}</span></li>}
            {(g.other_places ?? []).map((o) => (
              <li><span class="k">{o.place}</span><span class="v">{teamText(o.team)}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  {wantsResults && (
    <section class="panel">
      <h2>成績</h2>
      <p style="margin:0 0 12px">
        這場比賽已經結束，但我們查不到公開的成績資料，所以這裡留白——不放推測的名次。
      </p>
      <p style="margin:0 0 14px;color:var(--color-text-muted)">
        如果您知道名次，歡迎提供。我們只收錄<strong>隊伍名稱</strong>，不收選手姓名等個人資料；
        建檔時會標注來源與查核日期。
      </p>
      <p style="margin:0">
        <a class="btn-action" href={resultsMailto({ path: `/events/${event.id}/`, title: d.title })}>來信提供成績</a>
        <span style="display:inline-block;margin-left:12px">
          或<a href={resultsUrl({ path: `/events/${event.id}/`, title: d.title })} rel="noopener" target="_blank">在 GitHub 提交 ↗</a>
        </span>
      </p>
    </section>
  )}

  {relatedArticles.length > 0 && (
    <section class="panel">
      <h2>相關文章</h2>
      <ul class="data-list">
        {relatedArticles.map((a) => (
          <li><a href={url(`/learn/${a.id}`)}>{a.data.title}</a></li>
        ))}
      </ul>
    </section>
  )}

  {d.sources?.length ? (
    <section class="panel">
      <SourceBlock sources={d.sources} verification={d.verification} title={d.title} />
    </section>
  ) : null}
  <script>
    // 「最後確認於 X」在頁面上是靜態的，但「那是多久以前」只有讀者的瀏覽器知道——
    // 站台是靜態產生的，建置日不等於閱讀日，把天數算在建置期會愈放愈錯。
    // 超過三週就把整段轉成警示色：一場已經因颱風延期過一次的比賽，
    // 讀者是要決定要不要開車出門的人，資料多舊必須讓他自己判斷。
    const box = document.querySelector<HTMLElement>('.event-freshness');
    const stamp = box?.dataset.lastChecked;
    if (box && stamp) {
      const days = Math.floor((Date.now() - new Date(`${stamp}T00:00:00+08:00`).getTime()) / 86400000);
      if (Number.isFinite(days) && days >= 0) {
        box.querySelector('.event-freshness__age')!.textContent = `（${days} 天前）`;
        if (days >= 21) {
          box.style.background = 'color-mix(in oklab, var(--color-warning) 14%, var(--color-surface))';
          box.style.border = '1px solid var(--color-warning)';
        }
      }
    }
  </script>
</BaseLayout>

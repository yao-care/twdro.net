---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import SubscribeBox from '../../components/SubscribeBox.astro';
import { url } from '../../lib/url';
import { isPublicEvent } from '../../lib/enums';
import { hasTeam } from '../../lib/results';
import { citySlug } from '../../lib/geo.mjs';
import { collectionPageJsonLd } from '../../lib/jsonld';

const all = (await getCollection('events'))
  .filter((e) => isPublicEvent(e.data.status));   // 草稿不公開，待人工升級 status 後才顯示

type EventEntry = (typeof all)[number];

const byDateDesc = (a: EventEntry, b: EventEntry): number => {
  const da = a.data.schedule.event_start ?? '';
  const db = b.data.schedule.event_start ?? '';
  if (!da) return 1; if (!db) return -1;   // 無日期排最後
  return db.localeCompare(da);
};
const byDateAsc = (a: EventEntry, b: EventEntry): number => -byDateDesc(a, b);

// 依「使用者當下在找什麼」分三組，而非單一條倒序清單：
// 找報名的人只看得懂「還能報名的」，找成績的人只要「已結束的」。
// 分組依 status 而非日期——日期會過，status 是人工／pipeline 維護的事實欄位。
const OPEN = ['registration_open'];
const UPCOMING = ['announced', 'registration_closed', 'ongoing', 'postponed'];
const DONE = ['completed', 'results_pending', 'archived'];

const open = all.filter((e) => OPEN.includes(e.data.status)).sort(byDateAsc);
const upcoming = all.filter((e) => UPCOMING.includes(e.data.status)).sort(byDateAsc);
const done = all.filter((e) => DONE.includes(e.data.status)).sort(byDateDesc);
const other = all.filter((e) =>
  ![...OPEN, ...UPCOMING, ...DONE].includes(e.data.status)).sort(byDateDesc);   // cancelled 等

// 賽事系列總覽：這是只有樞紐頁才給得出的資訊（單一賽事頁看不到「這個系列有幾站」）。
// 系列名取自 events YAML 的 event_series，不另外編造分類。
const seriesMap = new Map<string, { count: number; withResults: number }>();
for (const e of all) {
  const name = e.data.event_series;
  if (!name) continue;
  const cur = seriesMap.get(name) ?? { count: 0, withResults: 0 };
  cur.count += 1;
  const r = e.data.results;
  // 分組別賽事的成績只在 divisions 裡，漏算會讓「已有成績」的統計低報。
  if (r && (hasTeam(r.champion_team) || hasTeam(r.runner_up_team) || hasTeam(r.third_place_team)
    || r.divisions?.some((x) => hasTeam(x.champion_team) || hasTeam(x.runner_up_team) || hasTeam(x.third_place_team)))) cur.withResults += 1;
  seriesMap.set(name, cur);
}
const series = [...seriesMap.entries()].sort((a, b) => b[1].count - a[1].count);
const cityCount = new Set(all.map((e) => e.data.schedule.city).filter(Boolean)).size;
const resultCount = all.filter((e) => {
  const r = e.data.results;
  return !!r && (hasTeam(r.champion_team) || hasTeam(r.runner_up_team) || hasTeam(r.third_place_team)
    || r.divisions?.some((x) => hasTeam(x.champion_team) || hasTeam(x.runner_up_team) || hasTeam(x.third_place_team)));
}).length;

// 依縣市分組：找比賽的人問的是「我這邊有沒有」。縣市頁完全由既有資料交叉產生，
// 這裡只是把入口露出來——沒有入口的頁等於不存在（/organizations/ 卡了 38 天沒被爬就是教訓）。
const cityCounts = new Map<string, number>();
for (const e of all) {
  const slug = citySlug(e.data.schedule.city);
  if (slug) cityCounts.set(slug, (cityCounts.get(slug) ?? 0) + 1);
}
const cities = [...cityCounts.entries()]
  .map(([slug, count]) => ({ slug, name: all.find((e) => citySlug(e.data.schedule.city) === slug)!.data.schedule.city!, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-Hant'));

const groups = [
  { key: 'open', heading: '開放報名中', items: open,
    note: '報名期間以主辦單位公告為準，點進去可看報名截止日與報名連結。' },
  { key: 'upcoming', heading: '即將舉行', items: upcoming,
    note: '已公告日期、尚未舉行的賽事。' },
  { key: 'done', heading: '已結束', items: done,
    note: '已結束的賽事。有查到成績的會列出名次，查不到就留白。' },
  { key: 'other', heading: '取消或延期', items: other, note: '' },
].filter((g) => g.items.length > 0);

// 索引頁原本一個 JSON-LD 都沒有（含旗艦頁 /events），等於有整份賽事資料庫卻沒告訴 Google
// 這頁在列什麼。ItemList 只列公開賽事，與畫面同一份 `all`，不會各說各話。
const jsonld = collectionPageJsonLd({
  name: '臺灣無人機足球賽事',
  url: 'https://twdro.net/events/',
  description: '臺灣無人機足球（無人機飛球）賽事列表，含報名中、即將舉行與已結束賽事。',
  items: all.map((e) => ({ name: e.data.title, url: `https://twdro.net/events/${e.id}/` })),
});

---
<BaseLayout
  title="台灣無人機足球比賽：報名、賽程、日期與成績 | twdro.net"
  description={`台灣（臺灣）無人機足球比賽與賽事資料：目前收錄 ${all.length} 場、${series.length} 個系列，整理報名狀態、比賽日期、地點與成績。`}
  heroTitle="台灣無人機足球比賽與賽事"
  heroDesc="查台灣（臺灣）無人機足球的報名、賽程、比賽日期、地點與成績。"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <section class="panel" style="margin-bottom:20px">
    <h2>在台灣找無人機足球，先從這裡開始</h2>
    <p style="margin:0 0 16px">
      本頁是台灣無人機足球的賽事入口：先看目前能報名或即將舉行的比賽，再往下找已結束賽事的成績與歷年系列。
      日期、地點、報名狀態與成績都以公開資料整理，查不到的欄位留白，不以推測填補。
    </p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:12px;margin-bottom:18px">
      <div style="padding:14px;background:var(--color-surface-muted);border-radius:10px">
        <strong style="display:block;font-size:1.35rem">{all.length}</strong>
        <span class="text-muted">收錄賽事</span>
      </div>
      <div style="padding:14px;background:var(--color-surface-muted);border-radius:10px">
        <strong style="display:block;font-size:1.35rem">{series.length}</strong>
        <span class="text-muted">賽事系列</span>
      </div>
      <div style="padding:14px;background:var(--color-surface-muted);border-radius:10px">
        <strong style="display:block;font-size:1.35rem">{cityCount}</strong>
        <span class="text-muted">舉辦縣市</span>
      </div>
      <div style="padding:14px;background:var(--color-surface-muted);border-radius:10px">
        <strong style="display:block;font-size:1.35rem">{resultCount}</strong>
        <span class="text-muted"><a href={url('/events/results')}>已有成績 →</a></span>
      </div>
    </div>
    <div style="margin:0 0 18px">
      <h3 style="margin:0 0 8px;font-size:1.02rem">依縣市找</h3>
      <p style="margin:0;line-height:2">
        {cities.map((c) => (
          <><a href={url(`/events/city/${c.slug}/`)} style="display:inline-block;padding:.2rem .7rem;margin:0 .4rem .2rem 0;border:1px solid var(--color-border);border-radius:999px">{c.name}<span class="text-muted" style="font-size:.88rem">　{c.count}</span></a></>
        ))}
      </p>
    </div>
    <ul class="card-grid" style="margin:0">
      <li><a class="card-link" href={url('/events/results')}><span class="name">看比賽成績</span><span class="meta">各賽事名次一次看完，附原始公告來源</span></a></li>
      <li><a class="card-link" href={url('/events/calendar')}><span class="name">按月份找賽程</span><span class="meta">日曆檢視、狀態篩選與報名截止日</span></a></li>
      <li><a class="card-link" href={url('/learn/taiwan-competitions-overview')}><span class="name">比較賽事系列</span><span class="meta">教育部、天穹盃、教育科技盃與縣市賽規格差異</span></a></li>
      <li><a class="card-link" href={url('/organizations')}><span class="name">找主辦與推廣單位</span><span class="meta">協會、學校、政府與器材／課程單位</span></a></li>
    </ul>
  </section>

  <SubscribeBox />

  {series.length > 0 && (
    <section class="panel" style="margin-bottom:20px">
      <h2>賽事系列</h2>
      <p style="margin:0 0 12px;color:var(--color-text-muted)">
        同一個系列會在不同城市辦分站，規則與組別多半一致。
      </p>
      <ul style="margin:0;padding-left:1.4em">
        {series.map(([name, info]) => (
          <li style="margin-bottom:6px">
            {name} — 收錄 {info.count} 場{info.withResults > 0 ? `，其中 ${info.withResults} 場已有成績` : ''}
          </li>
        ))}
      </ul>
    </section>
  )}

  {groups.map((g) => (
    <section style="margin-bottom:32px">
      <h2 style="margin:0 0 6px">{g.heading}（{g.items.length}）</h2>
      {g.note && <p style="margin:0 0 16px;color:var(--color-text-muted)">{g.note}</p>}
      <div style="display:grid;gap:18px">
        {g.items.map((e) => (
          <EventCard
            id={e.id}
            title={e.data.title}
            status={e.data.status}
            eventStart={e.data.schedule.event_start}
            eventEnd={e.data.schedule.event_end}
            city={e.data.schedule.city}
            venue={e.data.schedule.venue_name}
            registrationEnd={e.data.schedule.registration_end}
            registrationUrl={e.data.registration_url}
          />
        ))}
      </div>
    </section>
  ))}

  {all.length === 0 && <p>目前沒有可公開的賽事資料。</p>}
</BaseLayout>

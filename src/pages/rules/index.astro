---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
import { collectionPageJsonLd } from '../../lib/jsonld';
const books = await getCollection('rulebooks');
const SYSTEMS: [string, string][] = [['FAI', 'FAI'], ['FIDA', 'FIDA'], ['MOE', '教育部'], ['OTHER', '民間賽事']];

const jsonld = collectionPageJsonLd({
  name: '無人機足球規則書',
  url: 'https://twdro.net/rules/',
  description: 'FAI、FIDA、教育部與民間賽事的無人機足球規則書與條文對照。',
  items: books.map((b) => ({ name: b.data.name, url: `https://twdro.net/rules/${b.id}/` })),
});

---
<BaseLayout title="無人機足球規則總覽：FAI F9A-B、FIDA、教育部與天穹盃對照 | twdro.net" heroTitle="規則總覽" heroDesc="FAI、FIDA、教育部與各民間賽事規則各自獨立，請勿跨體系混用。">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <p style="margin:0 0 24px"><a class="btn-action" href={url('/rules/compare')}>規則比較器（並排比較賽制）→</a></p>
  {SYSTEMS.map(([sys, label]) => {
    const list = books.filter((b) => b.data.rule_system === sys);
    return list.length ? (
      <section>
        <h2 class="group-title">{label}</h2>
        <ul class="card-grid">
          {list.map((b) => (
            <li>
              <a class="card-link" href={url(`/rules/${b.id}`)}>
                <span class="name">{b.data.name}</span>
                <span class="meta">{b.data.organization} · 版本 {b.data.version}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null;
  })}
</BaseLayout>

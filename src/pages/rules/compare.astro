---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SPEC_FIELDS, SYSTEM_LABELS } from '../../lib/compare';
import { url } from '../../lib/url';
import { collectionPageJsonLd } from '../../lib/jsonld';
const rulebooks = await getCollection('rulebooks');
const books = rulebooks.map((b) => ({
  id: b.id,
  name: b.data.name,
  system: SYSTEM_LABELS[b.data.rule_system] ?? b.data.rule_system,
  spec: b.data.competition_spec ?? {},
}));
const dataJson = JSON.stringify({ books, fields: SPEC_FIELDS });

// 裁判與判決：站上唯一沒有被任何一頁承接的查詢意圖之一（Bing 對「無人機足球」回的
// 建議字裡就有「無人機足球裁判」）。條文其實早就收在 src/content/rules，只是散在四套
// 規則裡、沒有人並排看過——而「誰說了算」正好是四套規則差最多的地方之一。
//
// 刻意用 tags 篩而不是寫死條文清單：規則書由人工／pipeline 更新，寫死的清單會與資料走鐘，
// 而走鐘的樣子是「少列一條」——沒有人看得出來少了什麼。新增判決類條文只要打對 tag 就會出現。
const JUDGING_TAGS = ['裁判', '判決', '犯規', '黃牌', '紅牌', '罰球'];
const allRules = await getCollection('rules');
const judgingByBook = rulebooks.map((b) => ({
  id: b.id,
  name: b.data.name,
  system: SYSTEM_LABELS[b.data.rule_system] ?? b.data.rule_system,
  articles: allRules
    .filter((r) => r.data.rulebook === b.id)
    .filter((r) => (r.data.tags ?? []).some((t: string) => JUDGING_TAGS.includes(t)))
    .sort((a, x) => String(a.data.article_number ?? '').localeCompare(String(x.data.article_number ?? ''), undefined, { numeric: true })),
}));
const withJudging = judgingByBook.filter((b) => b.articles.length > 0);
const withoutJudging = judgingByBook.filter((b) => b.articles.length === 0);

const jsonld = collectionPageJsonLd({
  name: '無人機足球規則比較',
  url: 'https://twdro.net/rules/compare/',
  description: 'FAI、FIDA、教育部與民間賽事規則書的球機規格與賽制逐項對照。',
  items: books.map((b) => ({ name: b.name, url: `https://twdro.net/rules/${b.id}/` })),
});

---
<BaseLayout
  title="無人機足球規則比較：球機規格、賽制與裁判判決一次對照 | twdro.net"
  description="並排比較 FAI、FIDA、教育部與天穹盃四套無人機足球規則：球機規格、賽制，以及裁判編制與判決權限——同一個動作在不同規則下的判法並不一樣。條文逐條標明出處。"
  heroTitle="規則比較器"
  heroDesc="勾選要比較的規則版本，並往下看四套規則的裁判編制與判決條文。不同體系規則各自獨立，請勿視為可互換。"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <fieldset id="book-picker" class="panel" style="border:1px solid var(--color-border);margin:0 0 20px">
    {books.map((b) => (
      <label style="display:inline-block;margin:.3rem 1.5rem .3rem 0">
        <input type="checkbox" value={b.id} checked /> {b.name}
      </label>
    ))}
  </fieldset>
  <div class="panel" style="overflow-x:auto"><div id="compare-result"></div></div>

  <section class="panel" style="margin-top:20px">
    <h2>台灣選手要注意：國內兩套規格不通用</h2>
    <p>
      台灣目前並存兩套規格，差別最大的是<strong>球機本身</strong>。
      <a href="/rules/moe-taiwan-2026/">教育部 115 年全國無人機足球競賽</a> 明文採用
      <a href="/rules/fai-f9a-b-2026/">FAI F9A-B</a> 國際規格：球徑 20 公分、起飛重量上限 300 公克、電池最高 4S。
      <a href="/rules/skycup-2026/">天穹盃</a> 則是主辦單位自訂規格：同樣 20 公分，但起飛重量壓到
      <strong>110 公克以下</strong>、電池只能 2S，且<strong>明文指定 1020 有刷馬達</strong>。
    </p>
    <p>
      重量差近三倍、電壓差一倍，等於是兩台飛行特性完全不同的機器。
      <strong>在天穹盃練出來的手感不會直接搬到全國賽</strong>，反之亦然——推重比、慣性、撞擊後的姿態恢復都不一樣。
      要跨賽事參加的隊伍，等於要準備兩套機隊、練兩種手感。兩種馬達的實際差異見
      <a href="/learn/motor-brushed-vs-brushless/">有刷與無刷馬達怎麼選</a>。
    </p>
    <p style="color:var(--color-text-muted);font-size:.92rem;margin-bottom:0">
      注意「馬達類型」這一列的寫法：只有天穹盃是<em>限定</em>有刷，FAI 與教育部規則<em>沒有限定</em>有刷或無刷，
      只規定限電動馬達、最多 4 顆。也就是說全國賽並不禁止有刷機，只是 300 公克、4S 的規格下多數隊伍會選無刷。
      各欄位以官方規則書原文為準，本站不代為解釋規則。
    </p>
  </section>
  <section class="panel" style="margin-top:20px" id="judging">
    <h2>裁判怎麼配置、誰說了算</h2>
    <p>
      四套規則差最多的地方不只在球機。<strong>同一個動作在不同規則下的判法與判它的人都不一樣</strong>，
      而這件事在賽前檢錄與抗議時才會被發現。以下是本站收錄的判決類條文，逐條連回原文與出處。
    </p>
    <ul style="margin:0 0 18px;padding-left:1.4em">
      <li><strong>FIDA Class 40</strong>：<strong>主裁判加兩位助理裁判</strong>。局末由主裁判指示助理裁判核對犯規次數，
        雙方犯規先互相抵銷、只罰淨值較多的一方；罰球在每局結束後才執行。比賽中前鋒退出時，引導手的接任是否成立也由主裁判認定並宣告。</li>
      <li><strong>FAI F9A-B</strong>（教育部全國賽採用同一套規格）：<strong>所有處罰由主審裁定</strong>，且不跨場次累計；
        得分由得分裁判判定。採黃紅牌制，單場兩張黃牌即轉紅牌，收紅牌者逐出該場，該隊剩餘時間須少一台球機出賽。</li>
      <li><strong>天穹盃</strong>：<strong>主審與裁判</strong>依大會判決守則裁量，兩者判決不一致時<strong>以主審為準</strong>。</li>
    </ul>
    {withJudging.map((b) => (
      <div style="margin-top:18px">
        <h3 style="margin:0 0 8px;font-size:1.08rem">
          <a href={url(`/rules/${b.id}/`)}>{b.name}</a>
          <span class="text-muted" style="font-weight:500;font-size:.92rem">　{b.system}</span>
        </h3>
        <ul class="data-list">
          {b.articles.map((r) => (
            <li>
              <span class="k">{r.data.article_number ?? '—'}</span>
              <span class="v">
                <a href={url(`/rules/${b.id}/`)}>{r.data.title}</a>
                {r.data.summary && <span style="display:block;color:var(--color-text-muted);font-size:.95rem;margin-top:4px">{r.data.summary}</span>}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
    {withoutJudging.length > 0 && (
      <p class="text-muted" style="margin-top:18px;margin-bottom:0">
        {withoutJudging.map((b) => b.name).join('、')}
        ：本站尚未收錄其判決類條文——
        <a href={url('/rules/moe-taiwan-2026/')}>教育部全國賽</a>明文採用 FAI F9A-B 規格，判決依該套規則；
        其餘查不到的部分留白，不以推測補齊。看到我們漏收的條文，歡迎<a href={url('/about/correction/')}>回報</a>。
      </p>
    )}
    <p class="text-muted" style="font-size:.92rem;margin-top:18px;margin-bottom:0">
      想當裁判而不是被判的：教育部無人機教育推廣辦公室辦過 <strong>FAI 無人機足球裁判培訓課程</strong>，
      16 歲以上國人皆可報名、不限教師或在校生，梯次與辦理方式見
      <a href={url('/learn/moe-drone-office/')}>教育部在無人機足球上做了什麼</a>。
    </p>
  </section>

  <script type="application/json" id="compare-data" set:html={dataJson} />
  <script>
    import { compareRulebooks } from '../../lib/compare';
    const raw = document.getElementById('compare-data')!.textContent!;
    const { books } = JSON.parse(raw) as { books: { id: string; name: string; system?: string; spec: Record<string, any> }[] };
    const picker = document.getElementById('book-picker')!;
    const result = document.getElementById('compare-result')!;

    const thStyle = 'text-align:left;padding:.6rem .7rem;border-bottom:2px solid var(--color-border)';
    const tdStyle = 'padding:.6rem .7rem;border-bottom:1px solid var(--color-border)';
    const kdStyle = 'text-align:left;padding:.6rem .7rem;border-bottom:1px solid var(--color-border);color:var(--color-text-muted);font-weight:600';

    function el(tag: string, style: string, text?: string) {
      const node = document.createElement(tag);
      node.setAttribute('style', style);
      if (text !== undefined) node.textContent = text; // 安全：不用 innerHTML 插入 spec 值
      return node;
    }

    function render() {
      const checked = Array.from(picker.querySelectorAll('input:checked')).map((i) => (i as HTMLInputElement).value);
      const selected = books.filter((b) => checked.includes(b.id));
      result.replaceChildren();
      if (selected.length === 0) {
        result.appendChild(el('p', 'color:var(--color-text-muted)', '請至少勾選一個規則版本。'));
        result.firstElementChild!.className = 'text-muted';
        return;
      }
      const rows = compareRulebooks(selected);

      const table = document.createElement('table');
      table.className = 'data-table';
      table.setAttribute('style', 'min-width:100%');

      // 表頭：欄位 + 各規則書（標明體系）
      const thead = document.createElement('thead');
      const hr = document.createElement('tr');
      hr.appendChild(el('th', thStyle, '欄位'));
      for (const b of selected) {
        const th = el('th', thStyle);
        const name = document.createElement('div');
        name.textContent = b.name;
        th.appendChild(name);
        if (b.system) {
          const sys = el('div', 'font-size:.85rem;font-weight:600;color:var(--color-text-muted)', `體系：${b.system}`);
          th.appendChild(sys);
        }
        hr.appendChild(th);
      }
      thead.appendChild(hr);
      table.appendChild(thead);

      const tbody = document.createElement('tbody');
      for (const r of rows) {
        const tr = document.createElement('tr');
        tr.appendChild(el('th', kdStyle, r.label));
        for (const v of r.values) {
          tr.appendChild(el('td', tdStyle, v === undefined || v === null || v === '' ? '—' : String(v)));
        }
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      result.appendChild(table);
    }
    picker.addEventListener('change', render);
    render();
  </script>
</BaseLayout>

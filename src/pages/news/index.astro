---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectionPageJsonLd } from '../../lib/jsonld';
const news = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date));

// news 是本站整理的公告摘要、正文在外部，因此列 ItemList 而非 NewsArticle——
// 我們不是原始發布者，宣告 NewsArticle 會把出處算到自己頭上。
const jsonld = collectionPageJsonLd({
  name: '無人機足球公告與消息',
  url: 'https://twdro.net/news/',
  items: news.map((n) => ({ name: n.data.title, url: 'https://twdro.net/news/' })),
});

---
<BaseLayout
  title="臺灣無人機足球最新消息與賽事動態 | twdro.net"
  description="臺灣無人機足球最新賽事動態與消息。"
  heroTitle="最新消息"
  heroDesc="臺灣無人機足球最新賽事動態與消息。"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <div style="display:grid;gap:16px">
    {news.map((n) => (
      <article class="panel">
        <p class="text-muted" style="font-size:1rem;margin:0 0 6px">{n.data.date}</p>
        <h2 style="margin:0 0 10px;font-size:clamp(1.25rem,2.4vw,1.6rem)">{n.data.title}</h2>
        {n.data.summary && <p style="margin:0 0 10px">{n.data.summary}</p>}
        {n.data.source_url && (
          <p style="margin:0;font-size:1rem">
            <a href={n.data.source_url} rel="nofollow noopener" target="_blank">來源{n.data.source_publisher ? `：${n.data.source_publisher}` : ''} ↗</a>
          </p>
        )}
      </article>
    ))}
  </div>
</BaseLayout>

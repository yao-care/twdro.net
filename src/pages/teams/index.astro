---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
import { collectionPageJsonLd } from '../../lib/jsonld';
const teams = await getCollection('teams');
const GROUPS: [string, string][] = [
  ['elementary_school', '國小'], ['junior_high_school', '國中'], ['senior_high_school', '高中'],
  ['college', '專科'], ['university', '大專校院'], ['club', '俱樂部'],
  ['company', '企業'], ['community', '社區'], ['national_team', '代表隊'], ['temporary_team', '臨時隊伍'],
];

const jsonld = collectionPageJsonLd({
  name: '無人機足球隊伍',
  url: 'https://twdro.net/teams/',
  items: teams.map((t) => ({ name: t.data.name, url: `https://twdro.net/teams/${t.id}/` })),
});

---
<BaseLayout title="無人機足球隊伍名錄：學校、俱樂部與代表隊 | twdro.net" description="全臺無人機足球隊伍名錄，依國小、國中、高中、大專、俱樂部與代表隊分組，可查各隊招生狀態。" heroTitle="隊伍名錄" heroDesc="全臺無人機足球的學校、俱樂部與代表隊。">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <p style="margin:0 0 16px">
    <a class="btn-action" href={url('/teams/records/')}>隊伍與學校成績反查 →</a>
    <span class="text-muted" style="display:inline-block;margin-left:12px">查某一支隊伍或某一所學校在各賽事拿過什麼名次</span>
  </p>
  <p class="text-muted" style="margin:0 0 24px">
    本頁是已建檔的隊伍；<strong>只要在任何一場公開成績名單上出現過，就會出現在<a href={url('/teams/records/')}>成績反查</a>裡</strong>，即使還沒建檔。
    想知道這些隊伍在打哪些比賽，見 <a href={url('/learn/taiwan-competitions-overview/')} style="font-weight:650">臺灣有哪些無人機足球賽事</a>；
    想從零組一隊，見 <a href={url('/learn/starting-a-school-club/')}>怎麼在學校成立社團</a>。
  </p>
  {teams.length === 0 ? (
    <p class="panel text-muted">目前尚無登錄隊伍，歡迎各校與俱樂部提供資料。</p>
  ) : (
    GROUPS.map(([key, label]) => {
      const list = teams.filter((t) => t.data.team_type === key);
      return list.length ? (
        <section>
          <h2 class="group-title">{label}</h2>
          <ul class="card-grid">
            {list.map((t) => (
              <li>
                <a class="card-link" href={url(`/teams/${t.id}`)}>
                  <span class="name">{t.data.name}</span>
                  {t.data.recruitment_status && <span class="meta">{t.data.recruitment_status}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null;
    })
  )}
</BaseLayout>

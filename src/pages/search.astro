---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
import { webPageJsonLd } from '../lib/jsonld';
const bundlePath = url('/pagefind/');

const jsonld = webPageJsonLd({ name: '站內搜尋', url: 'https://twdro.net/search/' });

---
<BaseLayout
  title="搜尋 | twdro.net"
  description="搜尋全站賽事、規則、隊伍、場地與器材。"
  heroTitle="搜尋"
  heroDesc="搜尋全站賽事、規則、隊伍、場地與器材。"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonld)} />
  <link href={url('/pagefind/pagefind-ui.css')} rel="stylesheet" slot="head" />
  <div class="panel">
    <div id="search"></div>
  </div>
  <script type="application/json" id="pf-cfg" set:html={JSON.stringify({ bundlePath })} />
  <script>
    import { track } from '../lib/analytics';
    const { bundlePath } = JSON.parse(document.getElementById('pf-cfg')!.textContent!) as { bundlePath: string };
    const bindSearchTracking = () => {
      const input = document.querySelector<HTMLInputElement>('#search input');
      if (!input || input.dataset.gaBound === 'true') return;
      input.dataset.gaBound = 'true';
      let timer: number | undefined;
      let lastTerm = '';
      const sendSearch = () => {
        const term = input.value.trim();
        if (!term || term === lastTerm) return;
        lastTerm = term;
        track('search', { search_term: term });
      };
      input.addEventListener('input', () => {
        if (timer !== undefined) window.clearTimeout(timer);
        timer = window.setTimeout(sendSearch, 800);
      });
      input.addEventListener('change', sendSearch);
    };

    // 「搜了什麼」只說明讀者想找什麼；**「搜了卻沒有結果」才直接說出站上缺什麼**。
    // 這是站內唯一能指出內容缺口的訊號，而先前完全沒有量測（2026-08-27 補）。
    // Pagefind 把「沒有結果」渲染成一段訊息，所以觀察結果區塊的變化，
    // 有結果才送 result_count、零結果另送一個事件，方便在 GA4 直接篩。
    const bindEmptyTracking = (root: HTMLElement) => {
      let reported = '';
      const check = () => {
        const input = document.querySelector<HTMLInputElement>('#search input');
        const term = input?.value.trim() ?? '';
        if (!term || term === reported) return;
        const results = root.querySelectorAll('.pagefind-ui__result').length;
        // Pagefind 在載入中不會有 result node，也不會有 message；只在確定渲染完才回報。
        const message = root.querySelector('.pagefind-ui__message')?.textContent?.trim() ?? '';
        if (!message && results === 0) return;
        reported = term;
        if (results === 0) track('search_no_results', { search_term: term });
        else track('search_results', { search_term: term, result_count: results });
      };
      new MutationObserver(() => window.setTimeout(check, 250)).observe(root, { childList: true, subtree: true });
    };
    const s = document.createElement('script');
    s.src = bundlePath + 'pagefind-ui.js';
    s.onload = () => {
      // @ts-ignore - PagefindUI 由外部腳本掛到全域
      new (window as any).PagefindUI({ element: '#search', bundlePath, showSubResults: true, translations: { placeholder: '搜尋賽事、規則、隊伍、器材…' } });
      const root = document.getElementById('search')!;
      bindSearchTracking();
      bindEmptyTracking(root);
      new MutationObserver(bindSearchTracking).observe(root, { childList: true, subtree: true });
    };
    document.head.appendChild(s);
  </script>
</BaseLayout>

---
import { verificationLabel } from '../lib/enums';
import { correctionUrl, correctionMailto, CORRECTION_EMAIL } from '../lib/correction';
import { url } from '../lib/url';
interface SourceItem { type: string; url: string; published_at?: string; retrieved_at?: string; trust_level: string; }
interface Props { sources: SourceItem[]; verification?: string; title?: string; }
const { sources, verification, title } = Astro.props;
// 勘誤入口帶著「你正在看的這一頁」一起送出，見 src/lib/correction.ts。
// email 放前面：最該回報的協會、學校與主辦單位多半沒有 GitHub 帳號。
const target = { path: Astro.url.pathname, title: title ?? Astro.url.pathname };
const reportMailto = correctionMailto(target);
const reportUrl = correctionUrl(target);
const SOURCE_LABEL: Record<string, string> = {
  organizer_announcement: '主辦單位公告', moe_announcement: '教育部公告',
  fai_official: 'FAI 官方', fida_official: 'FIDA 官方', vendor_listing: '廠商資料',
  news: '新聞報導', news_article: '新聞報導', press_release: '官方新聞稿',
};
const label = (t: string) => SOURCE_LABEL[t] ?? t;
// 未指定 verification 時，依實際來源類型與信度給出誠實的資料狀態，不謊稱使用者投稿
const statusText = verification
  ? verificationLabel(verification)
  : (() => {
      const types = [...new Set(sources.map((s) => label(s.type)))].join('、');
      const trusts = [...new Set(sources.map((s) => s.trust_level))].sort().join('／');
      return `引用自${types}（信度 ${trusts}，未經第三方查核）`;
    })();
---
<aside style="color:var(--color-text-muted);font-size:1rem">
  <p style="margin:0 0 8px"><strong style="color:var(--color-text)">資料狀態：</strong>{statusText}</p>
  <p style="margin:0 0 6px"><strong style="color:var(--color-text)">資料來源</strong></p>
  <ul style="margin:0;padding-left:1.2em">
    {sources.map((s) => (
      <li style="margin:.2rem 0">
        <a href={s.url} rel="nofollow noopener" target="_blank">{label(s.type)}</a>
        （信度 {s.trust_level}
        {s.published_at ? `｜發布 ${s.published_at}` : ''}
        {s.retrieved_at ? `｜查核 ${s.retrieved_at}` : ''}）
      </li>
    ))}
  </ul>
  <p style="margin:14px 0 0">
    這頁的資料有誤？<a href={reportMailto} style="font-weight:650">來信 {CORRECTION_EMAIL} 回報</a>
    ，或<a href={reportUrl} rel="noopener" target="_blank">在 GitHub 提交 ↗</a>
    <span style="display:block;margin-top:4px;font-size:0.92rem">
      兩種方式都會預先帶入這一頁的網址。主辦單位與當事單位的回報優先處理。
      <a href={url('/about/correction/')}>更正流程</a>
    </span>
  </p>
</aside>

---
import { url } from '../lib/url';
import StatusBadge from './StatusBadge.astro';
interface Props {
  id: string;
  title: string;
  status: string;
  eventStart?: string;   // YYYY-MM-DD
  eventEnd?: string;     // YYYY-MM-DD；跨期賽事（如教育部分區賽 7/1–8/31）判斷有沒有過期要看它
  city?: string;
  venue?: string;
  registrationEnd?: string;
  registrationUrl?: string;
}
const { id, title, status, eventStart, eventEnd, city, venue, registrationEnd, registrationUrl } = Astro.props;
const parts = (eventStart ?? '').split('-');
const monthDay = parts.length === 3 ? `${parts[1]}.${parts[2]}` : '未定';
const year = parts.length === 3 ? parts[0] : '';
const place = [city, venue].filter(Boolean).join(' · ');
const canRegister = status === 'registration_open' && registrationUrl;
---
<article class="event-card" data-event-start={eventStart} data-event-last={eventEnd ?? eventStart} data-event-status={status}>
  <div class="event-card__date">
    <span class="event-card__month-day">{monthDay}</span>
    {year && <span class="event-card__year">{year}</span>}
  </div>
  <div class="event-card__content">
    <StatusBadge status={status} />
    {/* 賽期已過但狀態還停在「還沒發生」時，由瀏覽器補一個誠實的標記。
        分組刻意依 status 而非日期（見 pages/events/index.astro 的註解），代價是沒人更新
        資料時，打完的比賽會一直排在「即將舉行」。天數只能在讀者端算：站台是靜態產生的，
        建置日不等於閱讀日。CI 的 check-event-status 會同時提醒維護者去查證改狀態。 */}
    <span class="event-card__overdue" hidden>賽期已過，狀態未更新</span>
    <h3 class="event-card__title"><a href={url(`/events/${id}`)}>{title}</a></h3>
    <div class="event-card__meta">
      {place && <span>地點 {place}</span>}
      {registrationEnd && <span>報名截止 {registrationEnd}</span>}
    </div>
    {canRegister ? (
      <a
        class="btn-action"
        href={registrationUrl}
        rel="nofollow noopener"
        target="_blank"
        style="margin-top:20px"
        data-ga-event="registration_click"
        data-ga-event-id={id}
        data-ga-event-title={title}
        data-ga-event-status={status}
      >立即報名 →</a>
    ) : (
      <a class="btn-action" href={url(`/events/${id}`)} style="margin-top:20px;background:var(--color-brand);color:#fff">查看賽事 →</a>
    )}
  </div>
</article>

<style>
  .event-card__overdue {
    display: inline-block;
    margin-left: .5rem;
    padding: .15rem .5rem;
    border-radius: 999px;
    border: 1px solid var(--color-warning);
    background: color-mix(in oklab, var(--color-warning) 14%, var(--color-surface));
    font-size: .82rem;
    font-weight: 650;
  }
</style>
<script>
  // 只標「還沒發生」的狀態；已結束／取消／延期的賽事賽期本來就在過去，標了是雜訊。
  const FORWARD = ['announced', 'registration_open', 'registration_closed', 'ongoing'];
  const today = new Date();
  const todayIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Taipei' }).format(today);
  for (const card of document.querySelectorAll<HTMLElement>('.event-card[data-event-last]')) {
    // 用結束日（沒有就用開始日）：教育部分區賽是 7/1–8/31 的跨期賽事，
    // 只看開始日會在 7/2 就把一場還在進行的比賽標成「賽期已過」。
    const last = card.dataset.eventLast;
    const status = card.dataset.eventStatus ?? '';
    if (!last || !FORWARD.includes(status) || last >= todayIso) continue;
    const tag = card.querySelector<HTMLElement>('.event-card__overdue');
    if (tag) tag.hidden = false;
  }
</script>

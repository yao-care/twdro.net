---
// 推廣單位一覽，依類型分組。與 /organizations/ 同源（src/content/organizations/*.yml），
// 教育文寫死名單必然漏掉之後新增的單位。
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

// org_type 是自由字串欄位（school / association / vendor / university / government…），
// 這裡給已知值中文標籤並定序；未知值歸到最後、原樣顯示，不猜也不吞掉。
const TYPE_LABEL: Record<string, string> = {
  government: '政府單位',
  association: '協會',
  school: '學校',
  university: '大學',
  vendor: '器材與課程廠商',
  international_body: '國際組織',
};
const TYPE_ORDER = ['government', 'association', 'school', 'university', 'vendor', 'international_body'];

const orgs = await getCollection('organizations');
const groups = [...new Set(orgs.map((o) => o.data.org_type))].sort(
  (a, b) => (TYPE_ORDER.indexOf(a) + 1 || 99) - (TYPE_ORDER.indexOf(b) + 1 || 99),
);
---
{groups.map((type) => (
  <>
    <h3>{TYPE_LABEL[type] ?? type}</h3>
    <ul>
      {orgs
        .filter((o) => o.data.org_type === type)
        .map((o) => (
          <li>
            <a href={url(`/organizations/${o.id}`)}>{o.data.name}</a>
            {o.data.city && <span class="text-muted">（{o.data.city}）</span>}
          </li>
        ))}
    </ul>
  </>
))}
<p class="text-muted" style="margin-top:20px">
  名單以本站收錄為準，點進單位可看簡介與官網連結。完整清單見 <a href={url('/organizations/')}>推廣單位</a>。
</p>
